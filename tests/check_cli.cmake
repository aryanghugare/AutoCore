if(NOT DEFINED PROGRAM OR NOT DEFINED CASE)
    message(FATAL_ERROR "PROGRAM and CASE are required")
endif()

set(arguments "")
set(expected_exit 0)
if(CASE STREQUAL "default")
    set(expected_file "${CMAKE_CURRENT_LIST_DIR}/cli_expected/normal.txt")
elseif(CASE STREQUAL "normal")
    set(arguments --scenario normal)
    set(expected_file "${CMAKE_CURRENT_LIST_DIR}/cli_expected/normal.txt")
elseif(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_file "${CMAKE_CURRENT_LIST_DIR}/cli_expected/help.txt")
elseif(CASE STREQUAL "invalid")
    set(arguments --scenario unknown)
    set(expected_exit 2)
elseif(CASE STREQUAL "concurrent")
    set(arguments --concurrent)
else()
    set(arguments --scenario "${CASE}" --summary-only)
    set(expected_file "${CMAKE_CURRENT_LIST_DIR}/cli_expected/${CASE}.txt")
endif()

execute_process(COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
if(NOT result STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Exit code ${result}, expected ${expected_exit}\nstdout:\n${output}\nstderr:\n${error}")
endif()
# Normalize console line endings across Windows and POSIX hosts.
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\r\n" "\n" error "${error}")
if(CASE STREQUAL "invalid")
    if(NOT output STREQUAL "" OR NOT error MATCHES "Unknown scenario: unknown")
        message(FATAL_ERROR "Usage error must be on stderr without simulation output")
    endif()
else()
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${error}")
    endif()
    if(CASE STREQUAL "concurrent")
        foreach(marker "concurrent normal:" "concurrent apply:" "concurrent timeout:" "concurrent recovery:" "concurrent shutdown: workers joined")
            string(FIND "${output}" "${marker}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing concurrent lifecycle output: ${marker}\n${output}")
            endif()
        endforeach()
    else()
        file(READ "${expected_file}" expected)
        string(REPLACE "\r\n" "\n" expected "${expected}")
        if(NOT output STREQUAL expected)
            message(FATAL_ERROR "Output differs from ${expected_file}\nActual:\n${output}\nExpected:\n${expected}")
        endif()
    endif()
endif()
